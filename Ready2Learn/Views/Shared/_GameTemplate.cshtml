@using Ready2Learn.Data.Services
@using Ready2Learn.Models
@inject IGameContentService GameContentService

@model dynamic

@{
    string gameName = ViewData["GameName"] as string
        ?? (Model?.Name as string)
        ?? "Game";

    string question = ViewData["Question"] as string
        ?? string.Empty;

    string answer = ViewData["Answer"] as string
        ?? string.Empty;

    string grade = ViewData["Grade"] as string
        ?? string.Empty;

    var choices = ViewData["Choices"] as List<string>
        ?? new List<string>();

    int studentId = ViewData["StudentId"] is int sid
        ? sid
        : -1;

    if (string.IsNullOrEmpty(question) || string.IsNullOrEmpty(answer) || choices.Count == 0)
    {
        var qa = GameContentService.GetRandomQuestion(gameName, grade);

        if (qa != null)
        {
            question = qa.Question;
            answer = qa.Answer;

            // If the question explicitly defines its own answer list,
            // use only those options and do not generate any extra ones.
            if (qa.Options != null && qa.Options.Count > 0)
            {
                choices = qa.Options
                    .Where(o => !string.IsNullOrWhiteSpace(o))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                if (!choices.Any(c => string.Equals(c, answer, StringComparison.OrdinalIgnoreCase)))
                {
                    choices.Add(answer);
                }

                choices = choices
                    .OrderBy(_ => Guid.NewGuid())
                    .ToList();
            }
            else
            {
                // IMPORTANT: do not include any custom-option questions in the default pool.
                var pool = GameContentService
                    .GetQuestions(gameName, grade)
                    .Where(q => q.Options == null || q.Options.Count == 0)
                    .Select(q => q.Answer)
                    .Where(a => !string.IsNullOrWhiteSpace(a))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .ToList();

                var desiredCount = Math.Min(4, pool.Count);

                choices = new List<string> { answer };

                var distractors = pool
                    .Where(a => !string.Equals(a, answer, StringComparison.OrdinalIgnoreCase))
                    .OrderBy(_ => Guid.NewGuid())
                    .ToList();

                foreach (var distractor in distractors)
                {
                    if (choices.Count >= desiredCount)
                    {
                        break;
                    }

                    if (!choices.Contains(distractor, StringComparer.OrdinalIgnoreCase))
                    {
                        choices.Add(distractor);
                    }
                }

                choices = choices
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .OrderBy(_ => Guid.NewGuid())
                    .ToList();
            }
        }
        else
        {
            question = "No question available";
            answer = string.Empty;
            choices = new List<string>();
        }
    }
}

<div class="container align-items-center">
    <div class="row" style="margin-bottom: 20px;">
        <div class="col-12 text-center">
            <div class="d-flex justify-content-center align-items-center" style="gap:0.75rem;">
                <div id="questionText"
                     data-tts="@question"
                     data-tts-trigger="click"
                     style="text-align: center; font-size: 30px; font-weight: bold;">
                    @(question)
                </div>

                <button type="button"
                        id="readQuestionBtn"
                        class="btn btn-outline-secondary btn-sm read-tts-btn"
                        data-tts="@question"
                        data-tts-trigger="click"
                        aria-label="Read question">
                    <i class="bi bi-volume-up-fill" aria-hidden="true"></i>
                </button>
            </div>
        </div>
    </div>

    <form id="resultForm" asp-controller="Games" asp-action="SubmitResult" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="student" value="@studentId" />
        <input type="hidden" name="game" value="@gameName" />
        <input type="hidden" name="question" value="@question" />
        <input type="hidden" id="guessesString" name="guessesString" value="" />
        <input type="hidden" id="answerInput" name="answer" value="" />
    </form>

    <div class="d-flex flex-wrap justify-content-center gap-3">
        @foreach (string choice in choices)
        {
            bool isCorrect = string.Equals(choice, answer, StringComparison.OrdinalIgnoreCase);

            <div class="text-center">
                <button type="button"
                        class="btn btn-light square choice-button"
                        style="min-width: 120px;"
                        onclick='@(isCorrect ? "submitResult" : "addGuess")(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(choice)), this)'
                        data-tts="@choice"
                        data-tts-trigger="hover focus">
                    @choice
                </button>
            </div>
        }
    </div>
</div>

<style>
    .read-tts-btn {
        width: 40px;
        height: 40px;
        padding: 0.35rem 0.4rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 8px;
    }

    #questionText {
        max-width: 70%;
        word-wrap: break-word;
    }

    .choice-button {
        min-width: 120px;
        padding: 0.75rem 1rem;
        font-size: 1.1rem;
    }

    @@media (max-width: 576px) {
        #questionText {
            max-width: 100%;
            font-size: 24px;
        }

        .choice-button {
            min-width: 100px;
            font-size: 1rem;
        }
    }
</style>

<script>
    function submitResult(choice, button) {
        const form = document.getElementById('resultForm');
        const answerInput = document.getElementById('answerInput');
        const guessesString = document.getElementById('guessesString');

        answerInput.value = choice;
        guessesString.value = '';
        form.submit();
    }

    function addGuess(choice, button) {
        const form = document.getElementById('resultForm');
        const guessesInput = document.getElementById('guessesString');
        const answerInput = document.getElementById('answerInput');

        const current = (guessesInput.value || '').split(',').filter(Boolean);
        if (!current.includes(choice)) {
            current.push(choice);
        }

        guessesInput.value = current.join(',');
        answerInput.value = choice;
        form.submit();
    }
</script>