@model Ready2Learn.Models.TeacherCreateViewModel

@{
    ViewData["Title"] = "Create Account";
}

<div class="container align-items-center">
    <p><h1 style="text-align: center;">Create Account</h1></p>

    <form asp-action="CreateAccount" method="post" id="createAccountForm">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row offset-2">
            <div class="col-4">
                <label asp-for="FirstName" class="control-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>

            <div class="col-4">
                <label asp-for="LastName" class="control-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="row justify-content-center">
            <div class="col-4">
                <label asp-for="Username" class="control-label">Username</label>
                <input asp-for="Username" class="form-control" />
                <span asp-validation-for="Username" class="text-danger"></span>
            </div>

            <div class="col-4">
                <label asp-for="Password" class="control-label">Password</label>
                <input asp-for="Password" class="form-control" type="password" id="Password" name="Password" />
                <span class="text-danger" asp-validation-for="Password"></span>
            </div>

            <div class="col-4">
                <label asp-for="ConfirmPassword" class="control-label">Confirm Password</label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" id="ConfirmPassword" name="ConfirmPassword" />
                <span class="text-danger" asp-validation-for="ConfirmPassword"></span>
            </div>
        </div>
        <br />

        <div class="row offset-2">
            <div class="col-4">
                <label asp-for="Grade" class="control-label">Grade</label>
                <select asp-for="Grade" class="form-control">
                    <option value="PK">Preschool</option>
                    <option value="KG">Kindergarten</option>
                    <option value="1">First Grade</option>
                </select>
                <span asp-validation-for="Grade" class="text-danger"></span>
            </div>

            <div class="col-4">
                <label asp-for="ClassLink" class="control-label">Class Link</label>
                <input asp-for="ClassLink" class="form-control" />
                <span asp-validation-for="ClassLink" class="text-danger"></span>
            </div>
        </div>
        <br />

        <div class="row">
            <div class="col text-center">
                <input type="submit" value="Create Account" class="btn btn-light me-md-3" />
                <a class="btn btn-light ms-md-3" asp-action="LogIn">Log In</a>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        (function () {
            $(function () {
                var form = $("#createAccountForm");
                if (!form.length) return;

                // Use string-based RegExp to avoid Razor parsing issues
                var pwPattern = new RegExp("^(?=.*?[A-Z])(?=.*?[a-z])(?=.*?[0-9])(?=.*?[#?!$%^&*\\-])(?!.*\\s).{6,}$");

                jQuery.validator.addMethod("passwordPattern", function (value, element) {
                    if (!value) return false;
                    return pwPattern.test(value);
                }, "Password must be at least 6 characters and include upper and lower case letters, a number, and a special character.");

                form.validate();

                $("#Password").rules("add", {
                    required: true,
                    passwordPattern: true,
                    messages: {
                        required: "Password is required."
                    }
                });

                $("#ConfirmPassword").rules("add", {
                    equalTo: "#Password",
                    messages: {
                        equalTo: "Passwords do not match."
                    }
                });
            });
        })();
    </script>
}