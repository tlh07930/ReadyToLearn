@model Student

@{
    ViewData["Title"] = "Edit Student Details";
}

<div class="main-content">
    <form asp-action="EditStudentDetails">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row">
            <div class="col">
                <label asp-for="FirstName" class="control-label">First Name</label>
                <input asp-for="FirstName" class="form-control" />
                <span asp-validation-for="FirstName" class="text-danger"></span>
            </div>
        </div>
        <br>

        <div class="row">
            <div class="col">
                <label asp-for="LastName" class="control-label">Last Name</label>
                <input asp-for="LastName" class="form-control" />
                <span asp-validation-for="LastName" class="text-danger"></span>
            </div>
        </div>
        <br>

        <input type="hidden" asp-for="ID" />
        <input type="hidden" asp-for="TeacherID" />

        <div class="row">
            <div class="col text-center">
                <input type="submit" value="Update Student Details" class="btn btn-light me-md-3" />
            </div>
            <div class="col text-center">
                <a class="btn btn-light ms-md-3" asp-action="Students" asp-route-teacherId="@Model.TeacherID">Students</a>
            </div>
        </div>
    </form>
</div>