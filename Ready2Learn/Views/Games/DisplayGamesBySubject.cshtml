@model IEnumerable<Game>

@{
    ViewData["Title"] = $"{Model.FirstOrDefault()?.Subject} Games";
    var subject = Model.FirstOrDefault()?.Subject?.Trim();
    var gamesList = Model.ToList();
}

<div class="container align-items-center">
    @if (string.Equals(subject, "Science", System.StringComparison.OrdinalIgnoreCase))
    {
        <div class="row justify-content-center">
            @for (int i = 0; i < Math.Min(3, gamesList.Count); i++)
            {
                var game = gamesList[i];
                var actionName = game.Name.Replace(" ", string.Empty);
                var imageName = game.Name.Replace(" ", string.Empty);

                <div class="col-3 text-center" style="align-items: center;">
                    <a class="btn btn-light game-card square"
                       asp-action="@actionName"
                       role="button"
                       data-tts="@game.Name"
                       data-tts-trigger="hover focus"
                       aria-label="@game.Name">
                        <img class="game-image"
                             src="~/Images/GameButtons/@(imageName + ".png")"
                             alt="@game.Name" />
                    </a>
                </div>
            }
        </div>

        <br />

        @if (gamesList.Count > 3)
        {
            <div class="row justify-content-center">
                @for (int i = 3; i < gamesList.Count; i++)
                {
                    var game = gamesList[i];
                    var actionName = game.Name.Replace(" ", string.Empty);
                    var imageName = game.Name.Replace(" ", string.Empty);

                    <div class="col-3 text-center" style="align-items: center;">
                        <a class="btn btn-light game-card square"
                           asp-action="@actionName"
                           role="button"
                           data-tts="@game.Name"
                           data-tts-trigger="hover focus"
                           aria-label="@game.Name">
                            <img class="game-image"
                                 src="~/Images/GameButtons/@(imageName + ".png")"
                                 alt="@game.Name" />
                        </a>
                    </div>
                }
            </div>
        }
    }
    else
    {
        @foreach (Game[] games in Model.Chunk(4))
        {
            <div class="row justify-content-center">
                @foreach (Game game in games)
                {
                    var actionName = game.Name.Replace(" ", string.Empty);
                    var imageName = game.Name.Replace(" ", string.Empty);

                    <div class="col-3 text-center" style="align-items: center;">
                        <a class="btn btn-light game-card square"
                           asp-action="@actionName"
                           role="button"
                           data-tts="@game.Name"
                           data-tts-trigger="hover focus"
                           aria-label="@game.Name">
                            <img class="game-image"
                                 src="~/Images/GameButtons/@(imageName + ".png")"
                                 alt="@game.Name" />
                        </a>
                    </div>
                }
            </div>
            <br />
        }
    }
</div>